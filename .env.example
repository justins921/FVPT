# Server (local dev only)
PORT=3001

# Auth — generate ADMIN_HASH by running: npm run create-password
JWT_SECRET=change-this-to-a-random-string
ADMIN_USER=admin
ADMIN_HASH=

# Supabase — get these from your Supabase project dashboard
# Settings > API > Project URL
SUPABASE_URL=
# Settings > API > service_role key (keep secret!)
SUPABASE_SERVICE_KEY=
